    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "incognito": "split",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "core",
        "enabled": true,
        "path": "rules/core.json"
      },
      {
        "id": "strict",
        "enabled": false,
        "path": "rules/strict.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://dog.ceo https://images.dog.ceo https://cataas.com; img-src 'self' blob:; frame-ancestors 'none'"
  },
  "web_accessible_resources": [
